{
  "name": "@tanaab/codex-tools",
  "description": "Codex plugin development and easy installation: marketplace setup, npm installs, source refresh, and cache sync.",
  "version": "0.1.0",
  "author": "Tanaab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/codex-tools.git"
  },
  "bugs": {
    "url": "https://github.com/tanaabased/codex-tools/issues"
  },
  "homepage": "https://github.com/tanaabased/codex-tools#readme",
  "keywords": [
    "codex",
    "plugins",
    "cli",
    "marketplace",
    "cache"
  ],
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2",
  "bin": {
    "codex-tools": "dist/codex-tools"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/lib/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/lib/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    ".codex-plugin",
    "assets",
    "dist",
    "skills",
    "ADVANCED.md",
    "API.md",
    "CHANGELOG.md",
    "CLI.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:toolchain": "bun dev/scripts/check-toolchain-task.ts",
    "codex-tools": "bun run bin/codex-tools.ts",
    "lint": "bun run lint:eslint && bun run format:check",
    "lint:eslint": "bun --bun eslint .",
    "format:check": "bun --bun prettier . --check --ignore-unknown",
    "format:write": "bun --bun prettier . --write --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "docs:api": "bun dev/scripts/generate-api-task.ts",
    "docs:api:check": "bun dev/scripts/generate-api-task.ts --check",
    "docs:check": "bun run docs:api:check && bun dev/scripts/check-documentation-task.ts",
    "build": "bun dev/scripts/build-task.ts",
    "check:package": "bun dev/scripts/check-package-task.ts",
    "test": "bun run test:unit",
    "test:unit": "bun run test:app && bun run test:dev",
    "test:app": "bun --bun node_modules/mocha/bin/mocha.js 'test/*.spec.ts'",
    "test:dev": "bun --bun node_modules/mocha/bin/mocha.js 'dev/test/*.spec.ts'",
    "test:leia": "bun ./node_modules/.bin/leia",
    "test:native": "bun run build && bun dev/scripts/test-native-install-task.ts",
    "test:native:npm": "bun run build && bun dev/scripts/test-native-npm-task.ts"
  },
  "dependencies": {
    "@types/node": "^24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lando/leia": "2.0.0",
    "@types/bun": "1.4.2",
    "@types/mocha": "^10.0.10",
    "@types/npm-package-arg": "^6.1.4",
    "@types/semver": "^7.7.1",
    "ansis": "^4.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mocha": "11.8.0",
    "npm-package-arg": "^14.0.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "smol-toml": "^1.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
