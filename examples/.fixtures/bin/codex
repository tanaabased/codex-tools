#!/usr/bin/env node

import fs from 'node:fs';
import path from 'node:path';

const argv = process.argv.slice(2);
const home = process.env.HOME;
const codexHome = process.env.CODEX_HOME;
const logFile = process.env.CODEX_TOOLS_FIXTURE_LOG;

if (!home || !codexHome) {
  process.stderr.write('fake codex requires HOME and CODEX_HOME\n');
  process.exit(2);
}

if (logFile) {
  fs.mkdirSync(path.dirname(logFile), { recursive: true });
  fs.appendFileSync(
    logFile,
    JSON.stringify({
      command: 'codex',
      argv,
      home,
      codexHome,
      sentinel: process.env.CODEX_TOOLS_CHILD_SENTINEL ?? null,
    }) + '\n',
  );
}

if (process.env.FAKE_CODEX_EXIT) {
  process.stderr.write('synthetic native failure\n');
  process.exit(Number(process.env.FAKE_CODEX_EXIT));
}

const catalogFile = path.join(home, '.agents/plugins/marketplace.json');
const stateFile = path.join(codexHome, '.fake-codex-state.json');
const readJson = (file) => JSON.parse(fs.readFileSync(file, 'utf8'));
const catalog = fs.existsSync(catalogFile) ? readJson(catalogFile) : null;
const state = fs.existsSync(stateFile) ? readJson(stateFile) : { installed: [] };
const respond = (value) => process.stdout.write(JSON.stringify(value) + '\n');

if (argv[0] === '--version') {
  process.stdout.write('codex-cli 0.154.0\n');
  process.exit(0);
}

if (argv[0] !== 'plugin') {
  process.stderr.write('unexpected fake codex command\n');
  process.exit(2);
}

if (argv[1] === 'marketplace' && argv[2] === 'list') {
  respond({
    marketplaces: catalog
      ? [{ name: catalog.name, root: home, marketplaceSource: { sourceType: 'local' } }]
      : [],
  });
  process.exit(0);
}

if (argv[1] === 'list') {
  respond({ installed: state.installed, available: [] });
  process.exit(0);
}

if (argv[1] !== 'add' || !catalog) {
  process.stderr.write('unexpected fake codex plugin command\n');
  process.exit(2);
}

const separator = argv.indexOf('--');
const pluginId = separator >= 0 ? argv[separator + 1] : argv.at(-1);
const marker = pluginId.lastIndexOf('@');
const requestedName = pluginId.slice(0, marker);
const marketplaceName = pluginId.slice(marker + 1);
const entry = catalog.plugins.find((candidate) => candidate.name === requestedName);

if (!entry || marketplaceName !== catalog.name) {
  process.stderr.write('fake codex could not resolve the requested plugin\n');
  process.exit(2);
}

const npmSource = entry.source.source === 'npm';
const actualName = npmSource ? 'fixture-plugin' : entry.name;
if (npmSource && requestedName === 'codex-tools-identity-probe') {
  process.stderr.write(
    'plugin.json name `' +
      actualName +
      '` does not match marketplace plugin name `codex-tools-identity-probe`\n',
  );
  process.exit(1);
}

let version;
let sourceRoot = null;
if (npmSource) {
  version = entry.source.version;
} else {
  sourceRoot = fs.realpathSync(path.resolve(home, entry.source.path));
  version = readJson(path.join(sourceRoot, '.codex-plugin/plugin.json')).version;
}

const installedPath = path.join(codexHome, 'plugins/cache', catalog.name, actualName, version);
fs.rmSync(installedPath, { recursive: true, force: true });
fs.mkdirSync(path.dirname(installedPath), { recursive: true });
if (npmSource) {
  fs.mkdirSync(path.join(installedPath, '.codex-plugin'), { recursive: true });
  fs.writeFileSync(
    path.join(installedPath, '.codex-plugin/plugin.json'),
    JSON.stringify({ name: actualName, version }) + '\n',
  );
  fs.writeFileSync(
    path.join(installedPath, 'package.json'),
    JSON.stringify({ name: entry.source.package, version: entry.source.version }) + '\n',
  );
} else {
  fs.cpSync(sourceRoot, installedPath, { recursive: true });
}

const installed = {
  pluginId: actualName + '@' + catalog.name,
  name: actualName,
  marketplaceName: catalog.name,
  version,
  installed: true,
  enabled: true,
  authPolicy: 'ON_INSTALL',
  source: npmSource ? entry.source : { source: 'local', path: sourceRoot },
};
state.installed = state.installed.filter((candidate) => candidate.pluginId !== installed.pluginId);
state.installed.push(installed);
fs.mkdirSync(codexHome, { recursive: true });
fs.writeFileSync(stateFile, JSON.stringify(state));
respond({
  name: actualName,
  pluginId: installed.pluginId,
  marketplaceName: catalog.name,
  version,
  installedPath,
});
